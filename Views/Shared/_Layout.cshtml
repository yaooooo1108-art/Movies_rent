<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - 電影管理
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/_1131754.styles.css"
          asp-append-version="true" />

    <style>

        body {
            background-color: #121212;
            color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Navbar */

        .navbar-custom {
            background-color: #1c1c1c;
            border-bottom: 2px solid #ff4444;
            padding: 14px 30px;
        }

        .brand-logo {
            font-size: 2rem;
            font-weight: bold;
            color: #ff4444 !important;
            text-decoration: none;
            transition: 0.3s;
        }

            .brand-logo:hover {
                color: #ff7777 !important;
            }

        .navbar a {
            color: #ffffff !important;
            font-weight: bold;
        }

            .navbar a:hover {
                color: #ff6666 !important;
            }

        /* Dropdown */

        .dropdown-menu {
            background-color: #262626 !important;
            border: 1px solid #444;
        }

        .dropdown-item {
            color: #f5f5f5 !important;
        }

            .dropdown-item:hover {
                background-color: #ff4444 !important;
                color: white !important;
            }

        /* 購物車 */

        .cart-link {
            color: #ffd166 !important;
            font-size: 1.1rem;
            text-decoration: none;
            transition: 0.3s;
        }

            .cart-link:hover {
                color: #ffe29a !important;
            }

        /* 登入按鈕 */

        .login-btn {
            border: 1px solid #ff4444;
            color: #ff4444 !important;
            transition: 0.3s;
        }

            .login-btn:hover {
                background-color: #ff4444;
                color: white !important;
            }

        /* Main */

        main {
            min-height: 80vh;
        }

        /* Footer */

        footer {
            background-color: #1c1c1c;
            color: #999;
            padding: 20px;
            margin-top: 40px;
            border-top: 1px solid #333;
        }

            footer a {
                color: #ff6666;
                text-decoration: none;
            }

                footer a:hover {
                    color: #ff9999;
                }

    </style>

</head>

<body>

    <header class="navbar navbar-custom d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-4">

            @inject IHttpContextAccessor HttpContextAccessor

            <!-- Logo -->
            <a class="brand-logo"
               asp-controller="Movies"
               asp-action="Store">

                🎬 MovieStore

            </a>

            <!-- 搜尋 -->
            @await Html.PartialAsync("_MovieSearchForm")

        </div>

        <div class="d-flex align-items-center gap-4">

            @{
                var username = Context.Session.GetString("Username");
                var role = Context.Session.GetString("Role");
                var isLogin = !string.IsNullOrEmpty(username);
                var isAdmin = role == "admin";
            }

            <!-- 購物車 -->
            @if (!isAdmin)
            {
                <a href="/Cart/Shop"
                   class="cart-link d-flex align-items-center">

                    🛒 購物車

                </a>
            }

            <!-- 使用者 -->
            @if (isLogin)
            {
                <div class="dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="userDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        👤 @username

                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>

                            <a class="dropdown-item"
                               href="/Users/Profile">

                                個人資料

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item"
                               href="/Users/Order">

                                訂單紀錄

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item"
                               href="/Users/Logout">

                                登出

                            </a>

                        </li>

                    </ul>

                </div>
            }
            else
            {
                <a href="/Users/Index"
                   class="btn login-btn">

                    登入

                </a>
            }

        </div>

    </header>

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="text-center">

        <div class="container">

            &copy; 2026 - Movie 1131754

            |

            <a asp-area=""
               asp-controller="Movies"
               asp-action="Store">

                電影商城

            </a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>