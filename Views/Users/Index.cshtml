@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>

    <meta charset="utf-8" />
    <title>電影平台登入</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-image: url('/image/bk.jfif');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            /* 黑色遮罩 */
            body::before {
                content: "";
                position: absolute;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.78);
                top: 0;
                left: 0;
                z-index: 1;
            }

        .login-box {
            position: relative;
            z-index: 2;
            background: rgba(20, 20, 20, 0.88);
            padding: 45px;
            border-radius: 18px;
            width: 100%;
            max-width: 430px;
            color: white;
            box-shadow: 0 0 30px rgba(0,0,0,0.9);
            transform: translateY(-40px);
            backdrop-filter: blur(6px);
        }

        .movie-icon {
            font-size: 4rem;
            margin-bottom: 15px;
        }

        .logo-text {
            font-size: 2.6rem;
            font-weight: bold;
            color: #ff3c3c;
            margin-bottom: 10px;
        }

        .sub-text {
            color: #ccc;
            margin-bottom: 30px;
            font-size: 1.05rem;
        }

        .form-control {
            background-color: rgba(255,255,255,0.10);
            border: 1px solid #555;
            color: white;
            height: 52px;
            border-radius: 10px;
            padding-left: 15px;
        }

            .form-control:focus {
                background-color: rgba(255,255,255,0.16);
                color: white;
                border-color: #ff3c3c;
                box-shadow: 0 0 10px rgba(255,60,60,0.3);
            }

            .form-control::placeholder {
                color: #bbb;
            }

        .btn-login {
            background-color: #ff3c3c;
            border: none;
            height: 52px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 10px;
            transition: 0.3s;
        }

            .btn-login:hover {
                background-color: #e62e2e;
                transform: scale(1.01);
            }

        .form-check-label {
            color: #ddd;
        }

        .error {
            color: #ff8080;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .test-account {
            margin-top: 25px;
            font-size: 0.95rem;
            color: #ddd;
            line-height: 1.8;
        }

            .test-account strong {
                color: white;
            }

    </style>
</head>

<body>

    <div class="login-box text-center">

        <div class="movie-icon">🎬</div>

        <div class="logo-text">
            1131754 劉曜瑄
        </div>

        <div class="sub-text">
            電影管理平台登入系統
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error">
                @ViewBag.Error
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <input type="text"
                       name="username"
                       class="form-control"
                       placeholder="請輸入帳號"
                       required />
            </div>

            <div class="mb-3">
                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="請輸入密碼"
                       required />
            </div>

            <div class="mb-3 form-check text-start">

                <input type="checkbox"
                       class="form-check-input"
                       id="rememberMe" />

                <label class="form-check-label" for="rememberMe">
                    記住我
                </label>

            </div>

            <button type="submit" class="btn btn-login w-100">
                登入系統
            </button>

        </form>

        <div class="test-account">

            一般用戶：
            <strong>testuser</strong>
            /
            <strong>123456</strong>

            <br />

            管理員：
            <strong>admin</strong>
            /
            <strong>admin123</strong>

        </div>

    </div>
    
</body>
</html>