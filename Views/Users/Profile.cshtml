@{
    ViewData["Title"] = "會員個人檔案";
}

<style>

    body {
        background: linear-gradient(to bottom, #111111, #1b1b1b);
        color: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
    }

    .profile-container {
        max-width: 1100px;
        margin: auto;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        background-color: #1f1f1f;
        padding: 2rem;
        border-radius: 15px;
        border: 1px solid #333;
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid #ff4444;
        object-fit: cover;
    }

    .profile-name {
        font-size: 2rem;
        font-weight: bold;
        color: #ff5252;
    }

    .profile-level {
        color: #cccccc;
        margin-top: 8px;
        font-size: 1rem;
    }

    .profile-section {
        background-color: #1f1f1f;
        padding: 1.8rem;
        border-radius: 15px;
        margin-bottom: 1.5rem;
        border: 1px solid #333;
        box-shadow: 0 0 10px rgba(0,0,0,0.4);
    }

    .section-title {
        font-size: 1.4rem;
        margin-bottom: 1.2rem;
        color: #ff6666;
        font-weight: bold;
    }

    .info-text {
        line-height: 2;
        color: #dddddd;
    }

    .movie-list {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .movie-card {
        width: 180px;
        background-color: #2a2a2a;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
        border: 1px solid #444;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 15px rgba(255,68,68,0.4);
        }

        .movie-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

    .movie-title {
        padding: 10px;
        text-align: center;
        font-weight: bold;
        color: white;
    }

    .btn-custom {
        background-color: #ff4444;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background-color: #e63232;
        }

</style>

<div class="container py-5 profile-container">

    <h1 class="mb-4">🎬 會員個人檔案</h1>

    <div class="profile-header">

        <img src="/image/miffy.png"
             class="profile-avatar"
             alt="頭像" />

        <div>

            @{
                var username = Context.Session.GetString("Username");
                var isLogin = !string.IsNullOrEmpty(username);
            }

            @if (isLogin)
            {
                <div class="profile-name">
                    @username
                </div>
            }
            else
            {
                <div class="profile-name">
                    訪客使用者
                </div>
            }

            <div class="profile-level">
                🍿 VIP會員等級：Lv.12
            </div>

        </div>

    </div>

    <div class="profile-section">

        <div class="section-title">
            📄 個人資訊
        </div>

        <div class="info-text">
            電子郵件：movieuser@example.com<br />
            註冊日期：2025/03/15<br />
            最近登入：2026/05/28<br />
        </div>

    </div>

    <div class="profile-section">

        <div class="section-title">
            🎞 最近觀看電影
        </div>

        <div class="movie-list">

            <div class="movie-card">

                <img src="/image/avengers.jfif"
                     alt="Avengers" />

                <div class="movie-title">
                    Avengers: Endgame
                </div>

            </div>

            <div class="movie-card">

                <img src="/image/interstellar.jpg"
                     alt="Interstellar" />

                <div class="movie-title">
                    Interstellar
                </div>

            </div>

            <div class="movie-card">

                <img src="/image/johnwick.jpg"
                     alt="John Wick" />

                <div class="movie-title">
                    John Wick
                </div>

            </div>

        </div>

    </div>

</div>