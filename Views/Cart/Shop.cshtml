@model List<_1131754.Models.Cart>

@{
    ViewData["Title"] = "購物車";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #1b1f23;
        color: #e0e0e0;
    }

    .table-dark th, .table-dark td {
        vertical-align: middle;
    }

    .discount-badge {
        background-color: #28a745;
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .price-original {
        text-decoration: line-through;
        color: #888;
    }

    .price-final {
        color: #00d1b2;
        font-weight: bold;
    }

    .cart-total {
        font-size: 1.5rem;
        color: #00ff88;
    }

    .btn-custom {
        background-color: #00aaff;
        color: white;
        border: none;
    }

        .btn-custom:hover {
            background-color: #0088cc;
        }
</style>

<div class="container py-4">
    <h2 class="mb-4">🛒 電影購物車</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">目前購物車是空的。</div>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>電影</th>
                    <th>原價</th>
                    <th>折扣</th>
                    <th>折後價</th>
                    <th>數量</th>
                    <th>小計</th>
                    <th>操作</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    var price = item.Movie.Price;
                    var discount = item.Discount;
                    var final = price * (1 - discount);
                    var subtotal = final * item.Quantity;

                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div>@item.Movie.Name</div>
                            </div>
                        </td>

                        <td>
                            <span class="price-original">$@price</span>
                        </td>

                        <td>
                            <span class="discount-badge">-@(discount * 100)%</span>
                        </td>

                        <td>
                            <span class="price-final">$@final.ToString("0.##")</span>
                        </td>

                        <td>@item.Quantity</td>

                        <td class="fw-bold">
                            $@subtotal.ToString("0.##")
                        </td>

                        <td>
                            <form asp-action="Remove" asp-route-id="@item.MovieID" method="post">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    移除
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="5" class="text-end fw-bold">總金額：</td>
                    <td colspan="2" class="cart-total">
                        $@Model.Sum(i => i.Movie.Price * (1 - i.Discount) * i.Quantity).ToString("0.##")
                    </td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Movies" asp-action="Store" class="btn btn-secondary">
                ← 繼續購物
            </a>

            <form asp-action="Checkout" method="post">
                <button type="submit" class="btn btn-custom">
                    結帳
                </button>
            </form>
        </div>
    }
</div>