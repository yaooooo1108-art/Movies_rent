@{
    ViewData["Title"] = "電影商城";

    var isAdmin = Context.Session.GetString("Role") == "Admin";
}

<style>

    body {
        background-color: #1b1b1b;
        color: #e0e0e0;
    }

    .card {
        background-color: #2b2b2b;
        color: white;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.4);
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(255,68,68,0.3);
        }

    .card-img-top {
        height: 300px;
        object-fit: cover;
    }

    .card-title {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .price-text {
        color: #ffd166;
        font-size: 1.1rem;
        font-weight: bold;
    }

    .btn-detail {
        background-color: #ff4444;
        color: white;
        border: none;
    }

        .btn-detail:hover {
            background-color: #ff6666;
            color: white;
        }

    .btn-admin {
        min-width: 80px;
    }

    .page-link {
        background-color: #2b2b2b;
        color: white;
        border: none;
    }

        .page-link:hover {
            background-color: #ff4444;
            color: white;
        }

    .page-item.active .page-link {
        background-color: #ff4444;
        border: none;
    }

    .admin-panel {
        margin-bottom: 20px;
    }

</style>

<div class="container mt-4">

    <h2 class="mb-4 text-white">
        🎬 熱門電影
    </h2>

    @if (isAdmin)
    {
        <div class="admin-panel">
            <a asp-action="Create"
               class="btn btn-success">
                ➕ 新增電影
            </a>
        </div>
    }

    <div class="row">

        @foreach (var movie in Model)
        {
            <div class="col-md-3 mb-4">

                <div class="card h-100">

                    <a asp-action="Details"
                       asp-route-id="@movie.MovieID">

                        <img src="@movie.ImageUrl"
                             class="card-img-top"
                             alt="@movie.Name" />

                    </a>

                    <div class="card-body d-flex flex-column justify-content-between">

                        <div>

                            <h5 class="card-title">
                                @movie.Name
                            </h5>

                            <p class="text-muted">
                                🎭 @movie.Type
                            </p>

                            <p class="price-text">
                                NT$ @movie.Price.ToString("N0")
                            </p>

                            <p>
                                庫存：
                                @movie.Quantity
                            </p>

                        </div>

                        <div class="mt-3">

                            <a asp-action="Details"
                               asp-route-id="@movie.MovieID"
                               class="btn btn-detail btn-sm me-2">
                                詳細資訊
                            </a>

                            @if (isAdmin)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@movie.MovieID"
                                   class="btn btn-warning btn-sm btn-admin me-2">
                                    編輯
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@movie.MovieID"
                                   class="btn btn-danger btn-sm btn-admin">
                                    刪除
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    <div class="d-flex justify-content-center mt-4">

        @if (ViewBag.TotalPages > 1)
        {
            <nav>

                <ul class="pagination">

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               href="@Url.Action("Store", new { page = i })">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }

    </div>

</div>