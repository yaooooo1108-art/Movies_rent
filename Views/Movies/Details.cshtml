@model _1131754.Models.Movie

@{
    ViewData["Title"] = "電影詳細資訊";
    var isAdmin = Context.Session.GetString("Role") == "Admin";
}

<style>

    body {
        background: linear-gradient(to bottom, #111111, #1b1b1b);
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .movie-container {
        max-width: 1300px;
        margin: auto;
        margin-top: 40px;
    }

    .movie-card {
        background-color: #1f1f1f;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 25px rgba(0,0,0,0.5);
        border: 1px solid #333;
    }

    .movie-image {
        width: 100%;
        height: 650px;
        object-fit: cover;
    }

    .movie-content {
        padding: 40px;
    }

    .movie-title {
        font-size: 3rem;
        font-weight: bold;
        color: #ff5252;
        margin-bottom: 20px;
    }

    .movie-type {
        font-size: 1.2rem;
        color: #cccccc;
        margin-bottom: 20px;
    }

    .movie-price {
        color: #ffd166;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .movie-stock {
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .movie-description-title {
        font-size: 1.5rem;
        color: #ff7777;
        margin-bottom: 10px;
        font-weight: bold;
    }

    .movie-description {
        color: #dddddd;
        line-height: 2;
        margin-bottom: 40px;
    }

    .btn-cart {
        background-color: #ff4444;
        border: none;
        color: white;
        padding: 12px 28px;
        font-size: 1.1rem;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-cart:hover {
            background-color: #ff6666;
            color: white;
        }

    .btn-back {
        border: 1px solid #888;
        color: #ddd;
        padding: 12px 28px;
        border-radius: 10px;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-back:hover {
            background-color: #333;
            color: white;
        }

    .admin-btn {
        min-width: 100px;
    }

</style>

<div class="container movie-container">

    <div class="movie-card">

        <div class="row g-0">

            <div class="col-md-5">

                <img src="@Model.ImageUrl"
                     class="movie-image"
                     alt="@Model.Name" />

            </div>

            <div class="col-md-7">

                <div class="movie-content">

                    <div class="movie-title">
                        🎬 @Model.Name
                    </div>

                    <div class="movie-type">
                        類型：@Model.Type
                    </div>

                    <div class="movie-price">
                        NT$ @Model.Price.ToString("N0")
                    </div>

                    <div class="movie-stock">
                        庫存：@Model.Quantity
                    </div>

                    <div class="movie-description-title">
                        電影介紹
                    </div>

                    <div class="movie-description">
                        @Model.Description
                    </div>

                    <div class="d-flex gap-3 flex-wrap">

                        @if (!isAdmin)
                        {
                            <a asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-id="@Model.MovieID"
                               class="btn btn-cart">

                                🛒 加入購物車

                            </a>
                        }

                        <a asp-action="Store"
                           class="btn-back">

                            返回列表

                        </a>

                        @if (isAdmin)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.MovieID"
                               class="btn btn-warning admin-btn">

                                編輯

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.MovieID"
                               class="btn btn-danger admin-btn">

                                刪除

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>