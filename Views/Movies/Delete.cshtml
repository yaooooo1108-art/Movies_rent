@model _1131754.Models.Movie

@{
    ViewData["Title"] = "刪除電影";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
        body {
                background-color: #1b1f23;
                color: #e0e0e0;

    }

        .movie-info {
                background-color: #2a2f36;
                padding: 1.5rem;
                border-radius: 8px;
                margin-bottom: 2rem;

    }

            .movie-info dt {
                    color: #00aaff;

        }

            .movie-info img {
                    border: 2px solid #00aaff;
                    border-radius: 6px;

        }

        .btn-danger {
                background-color: #ff4d4d;
                border: none;

    }

            .btn-danger:hover {
                    background-color: #cc0000;

        }

        .btn-secondary {
                background-color: #444;
                border: none;

    }

            .btn-secondary:hover {
                    background-color: #666;

        }

        h2, h3 {
                color: #00d1b2;

    }
</style>

<h2>刪除電影</h2>
<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">類型</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">價格</dt>
        <dd class="col-sm-10">@Model.Price.ToString("C")</dd>

        <dt class="col-sm-2">庫存</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>

        <dt class="col-sm-2">簡介</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">圖片</dt>
        <dd class="col-sm-10"><img src="@Url.Content($"~/{Model.ImageUrl}")" alt="電影圖片" style="max-width:200px;" /></dd>
    </dl>
</div>

<form asp-action="Delete" asp-route-id="@Model.MovieID" method="post" onsubmit="return confirm('確定要刪除這款電影嗎？');">
    <button type="submit" class="btn btn-danger btn-sm">刪除</button>
    <a asp-action="Store" class="btn btn-secondary btn-sm">取消</a>

</form>

